{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/comment-guard.py\"",
            "statusMessage": "Checking added comments",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
