# Usage: TAILSCALE_AUTH_KEY=$(op read "op://Secrets/Tailscale Talos/credential") GITHUB_TOKEN=$(op read "op://Secrets/Github ArgoCD Token/credential") talhelper genconfig
# Apply: each node needs a combined multi-doc YAML (machine config + ExtensionServiceConfig for tailscale)
# See scripts/apply-all.sh or apply manually with cat clusterconfig/<node>.yaml + ExtensionServiceConfig doc
TAILSCALE_AUTH_KEY=op://Secrets/Tailscale Talos/credential
GITHUB_TOKEN=op://Secrets/Github ArgoCD Token/credential
